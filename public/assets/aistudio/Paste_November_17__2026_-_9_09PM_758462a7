import React from 'react';
import {
  FAMILY_LOCATIONS,
  WEEKDAYS_AR,
  convertCairoSlot,
  findFamilyLocation,
  suggestFamilyLocationFromPhone,
  zoneLabel,
} from '../../utils/schedule';
import { ChoiceGroup, Field, Select } from '../ui/Form';

// Where the family lives. Sets both the country and the time zone used to show them session times.
export const FamilyLocationSelect: React.FC<{
  timezone?: string;
  countryCode?: string;
  onChange: (value: { timezone?: string; countryCode?: string }) => void;
  id?: string;
  /** Parent's full WhatsApp number, used to suggest the country when none is chosen yet. */
  parentPhone?: string;
}> = ({ timezone, countryCode, onChange, parentPhone, id = 'family-location' }) => {
  const current = findFamilyLocation(timezone, countryCode);
  // Suggest only once a real number is typed (the country code alone is not enough)
  const hasNumber = (parentPhone || '').replace(/\D/g, '').length >= 8;
  const suggestion = !current && hasNumber ? suggestFamilyLocationFromPhone(parentPhone) : undefined;
  return (
    <Field
      id={id}
      label="بلد إقامة الأسرة"
      hint="ولي الأمر بيشوف مواعيد الحصص بتوقيت بلده، والمعلم بيشوفها بتوقيت القاهرة."
    >
      <Select
        value={current?.key || ''}
        onChange={(e) => {
          const loc = FAMILY_LOCATIONS.find((l) => l.key === e.target.value);
          onChange(loc ? { timezone: loc.timezone, countryCode: loc.countryCode } : { timezone: undefined, countryCode: undefined });
        }}
      >
        <option value="">غير محدد (بتوقيت القاهرة)</option>
        {FAMILY_LOCATIONS.map((l) => (
          <option key={l.key} value={l.key}>
            {l.label}
          </option>
        ))}
      </Select>
      {suggestion && (
        <button
          type="button"
          onClick={() => onChange({ timezone: suggestion.timezone, countryCode: suggestion.countryCode })}
          className="mt-2 inline-flex min-h-10 items-center gap-1.5 rounded-full border border-brand-200 bg-brand-50 px-3.5 text-sm font-bold text-brand-700 hover:bg-brand-100 cursor-pointer"
        >
          <span aria-hidden="true" className="material-symbols-outlined text-[18px]">
            lightbulb
          </span>
          من رقم الواتساب: {suggestion.label}، اضغط للاختيار
        </button>
      )}
    </Field>
  );
};

// Days of the week with a time per day, entered in Cairo time.
// `dayTimes` holds 24h "HH:MM" values keyed by Arabic day name.
export const WeeklyScheduleEditor: React.FC<{
  selectedDays: string[];
  dayTimes: Record<string, string>;
  onChange: (days: string[], times: Record<string, string>) => void;
  duration?: number;
  onDurationChange?: (minutes: number) => void;
  familyTimezone?: string;
  daysError?: string;
}> = ({ selectedDays, dayTimes, onChange, duration, onDurationChange, familyTimezone, daysError }) => {
  const ordered = WEEKDAYS_AR.filter((d) => selectedDays.includes(d));
  const showFamily = !!familyTimezone && familyTimezone !== 'Africa/Cairo';

  return (
    <div className="space-y-4">
      <ChoiceGroup
        label="أيام الحصص"
        required
        multiple
        columns={7}
        options={WEEKDAYS_AR.map((d) => ({ value: d, label: d }))}
        value={selectedDays}
        error={daysError}
        onChange={(days: string[]) => {
          const times: Record<string, string> = {};
          for (const d of days) times[d] = dayTimes[d] || '';
          onChange(days, times);
        }}
      />

      {ordered.length > 0 && (
        <div className="rounded-[var(--radius-control)] border border-line-soft bg-canvas/60 p-3 sm:p-4">
          <p className="mb-2.5 text-sm font-bold text-ink-soft">وقت كل حصة (بتوقيت القاهرة)</p>
          <ul className="space-y-2">
            {ordered.map((day) => {
              const time = dayTimes[day] || '';
              const family = showFamily && time ? convertCairoSlot(day, time, familyTimezone) : null;
              return (
                <li key={day} className="flex flex-wrap items-center gap-x-3 gap-y-1.5 rounded-[var(--radius-control)] bg-surface px-3 py-2.5 border border-line-soft">
                  <label htmlFor={`time-${day}`} className="w-20 shrink-0 text-[15px] font-bold text-ink">
                    {day}
                  </label>
                  <input
                    id={`time-${day}`}
                    type="time"
                    dir="ltr"
                    required
                    value={time}
                    onChange={(e) => onChange(selectedDays, { ...dayTimes, [day]: e.target.value })}
                    className="min-h-11 w-36 rounded-[var(--radius-control)] border border-line bg-field px-3 text-center text-base font-bold text-ink focus:border-brand-500 focus:outline-none focus:ring-3 focus:ring-brand-500/20"
                  />
                  {/* The field already shows the Cairo time; only add what the family sees */}
                  {!time ? (
                    <span className="text-sm text-muted">اختر الوقت</span>
                  ) : (
                    family && (
                      <span className="text-sm font-bold text-brand-700">
                        عند الأسرة: {family.day !== day ? `${family.day} ` : ''}
                        {family.time} ({zoneLabel(familyTimezone).replace('بتوقيت ', '')})
                      </span>
                    )
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )}

      {onDurationChange && (
        <ChoiceGroup
          label="مدة الحصة"
          columns={3}
          options={[30, 45, 60].map((m) => ({ value: m, label: `${m} دقيقة` }))}
          value={duration}
          onChange={onDurationChange}
        />
      )}
    </div>
  );
};
