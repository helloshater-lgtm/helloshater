import React, { useEffect, useId, useRef } from 'react';

// The one window used by every form and detail view.
//  - Phone: a sheet that rises from the bottom, as tall as its content (up to 92% of the screen).
//  - Computer: centered, in one of three fixed widths.
//  - Fixed title bar on top and fixed action bar at the bottom; only the middle scrolls.
//  - Esc closes it, the page behind does not scroll, and keyboard focus stays inside.

export type ModalSize = 'sm' | 'md' | 'lg';

const WIDTH: Record<ModalSize, string> = {
  sm: 'sm:max-w-[440px]',
  md: 'sm:max-w-[560px]',
  lg: 'sm:max-w-[720px]',
};

const FOCUSABLE =
  'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

let openCount = 0;

export interface ModalProps {
  open: boolean;
  onClose: () => void;
  title: React.ReactNode;
  description?: React.ReactNode;
  /** Material Symbols icon name shown next to the title */
  icon?: string;
  size?: ModalSize;
  /** Buttons shown in the fixed bottom bar */
  footer?: React.ReactNode;
  /** Message shown right above the buttons (e.g. why saving failed), where the user is looking */
  footerMessage?: React.ReactNode;
  /** Wrap the body and footer in a form so Enter submits and the footer submit button works */
  onSubmit?: (e: React.FormEvent) => void;
  /** Close when the dark background is clicked (default true; turn off for long forms) */
  closeOnBackdrop?: boolean;
  /**
   * The children lay out their own scrolling body and bottom bar (older windows moved onto this
   * frame). They are placed in a flex column under the title bar instead of the standard body.
   */
  bare?: boolean;
  /** Extra content under the title (e.g. a progress bar) */
  headerExtra?: React.ReactNode;
  children: React.ReactNode;
}

export const Modal: React.FC<ModalProps> = ({
  open,
  onClose,
  title,
  description,
  icon,
  size = 'md',
  footer,
  footerMessage,
  onSubmit,
  closeOnBackdrop = true,
  bare = false,
  headerExtra,
  children,
}) => {
  const panelRef = useRef<HTMLDivElement>(null);
  const titleId = useId();
  const descId = useId();
  const onCloseRef = useRef(onClose);
  onCloseRef.current = onClose;

  useEffect(() => {
    if (!open) return;
    const previouslyFocused = document.activeElement as HTMLElement | null;

    // Lock the page behind (counted, so stacked windows unlock correctly)
    openCount += 1;
    const prevOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';

    // Focus the first field (or the panel) when the window opens
    const t = window.setTimeout(() => {
      const panel = panelRef.current;
      if (!panel) return;
      const firstField = panel.querySelector<HTMLElement>('[data-autofocus], input:not([type="hidden"]), select, textarea');
      (firstField || panel).focus({ preventScroll: true });
    }, 30);

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        e.stopPropagation();
        onCloseRef.current();
        return;
      }
      if (e.key === 'Tab' && panelRef.current) {
        const items = Array.from(panelRef.current.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
          (el) => el.offsetParent !== null || el === document.activeElement
        );
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };
    document.addEventListener('keydown', onKey);

    return () => {
      window.clearTimeout(t);
      document.removeEventListener('keydown', onKey);
      openCount = Math.max(0, openCount - 1);
      if (openCount === 0) document.body.style.overflow = prevOverflow;
      previouslyFocused?.focus?.({ preventScroll: true });
    };
  }, [open]);

  if (!open) return null;

  const body = bare ? (
    <div className="flex min-h-0 flex-1 flex-col">{children}</div>
  ) : (
    <>
      <div className="flex-1 min-h-0 overflow-y-auto overscroll-contain px-5 py-5 sm:px-6">{children}</div>
      {footer && (
        <div className="shrink-0 border-t border-line-soft bg-surface px-5 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:px-6 sm:pb-4">
          {footerMessage && <div className="mb-3">{footerMessage}</div>}
          {/* Children in order [secondary, primary]: in RTL the primary sits on the left, wide on phones */}
          <div className="flex items-center justify-end gap-3 [&>*:last-child]:flex-1 sm:[&>*:last-child]:flex-none">
            {footer}
          </div>
        </div>
      )}
    </>
  );

  return (
    <div className="fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-6" dir="rtl">
      <div
        aria-hidden="true"
        className="absolute inset-0 bg-ink/50 animate-in fade-in duration-150"
        onClick={closeOnBackdrop ? onClose : undefined}
      />
      <div
        ref={panelRef}
        role="dialog"
        aria-modal="true"
        aria-labelledby={titleId}
        aria-describedby={description ? descId : undefined}
        tabIndex={-1}
        className={`relative flex w-full ${WIDTH[size]} max-h-[92dvh] sm:max-h-[86dvh] flex-col overflow-hidden rounded-t-[var(--radius-panel)] sm:rounded-[var(--radius-panel)] bg-surface text-ink shadow-[var(--shadow-panel)] outline-none animate-in slide-in-from-bottom-4 sm:slide-in-from-bottom-0 sm:zoom-in-95 duration-200`}
      >
        {/* Grab handle (phone) */}
        <div aria-hidden="true" className="sm:hidden flex justify-center pt-2.5">
          <span className="h-1 w-10 rounded-full bg-line" />
        </div>

        <header className="shrink-0 flex items-start gap-3 border-b border-line-soft px-5 pt-3 pb-4 sm:px-6 sm:pt-5">
          {icon && (
            <span aria-hidden="true" className="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
              <span className="material-symbols-outlined !text-[22px]">{icon}</span>
            </span>
          )}
          <div className="min-w-0 flex-1">
            <h2 id={titleId} className="text-lg font-bold leading-snug text-ink">
              {title}
            </h2>
            {description && (
              <p id={descId} className="mt-0.5 text-sm leading-relaxed text-muted">
                {description}
              </p>
            )}
          </div>
          <button
            type="button"
            onClick={onClose}
            aria-label="إغلاق"
            className="-mt-1 -ml-2 flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-muted hover:bg-canvas hover:text-ink focus-visible:outline-2 focus-visible:outline-brand-500 cursor-pointer"
          >
            <span aria-hidden="true" className="material-symbols-outlined text-[22px]">
              close
            </span>
          </button>
        </header>
        {headerExtra && <div className="shrink-0 border-b border-line-soft px-5 py-3 sm:px-6">{headerExtra}</div>}

        {onSubmit ? (
          <form onSubmit={onSubmit} noValidate className="flex min-h-0 flex-1 flex-col">
            {body}
          </form>
        ) : (
          body
        )}
      </div>
    </div>
  );
};
```

