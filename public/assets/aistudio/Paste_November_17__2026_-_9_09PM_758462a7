import React, { useId } from 'react';

// Form building blocks. Every field: 48px tall, 16px text (no iPhone zoom), the label above,
// help text under it, and the error in the same spot, linked for screen readers.

const CONTROL =
  'block w-full min-h-12 rounded-[var(--radius-control)] border bg-field px-3.5 text-base text-ink placeholder:text-muted/70 ' +
  'transition-colors focus:outline-none focus:ring-3 focus:ring-brand-500/20 disabled:bg-canvas disabled:text-muted';

const borderFor = (error?: string) => (error ? 'border-danger-600 focus:border-danger-600' : 'border-line focus:border-brand-500');

interface FieldContext {
  id: string;
  describedBy?: string;
  error?: string;
}
const FieldCtx = React.createContext<FieldContext | null>(null);

export interface FieldProps {
  label: React.ReactNode;
  required?: boolean;
  hint?: React.ReactNode;
  error?: string;
  /** Extra element aligned with the label (e.g. a small link) */
  action?: React.ReactNode;
  className?: string;
  /** Fixed id for the control (otherwise one is generated) */
  id?: string;
  children: React.ReactNode;
}

export const Field: React.FC<FieldProps> = ({ label, required, hint, error, action, className = '', id: fixedId, children }) => {
  const generatedId = useId();
  const id = fixedId || generatedId;
  const hintId = hint ? `${id}-hint` : undefined;
  const errorId = error ? `${id}-error` : undefined;
  const describedBy = [errorId, hintId].filter(Boolean).join(' ') || undefined;
  return (
    <FieldCtx.Provider value={{ id, describedBy, error }}>
      <div className={className}>
        <div className="mb-1.5 flex items-center justify-between gap-2">
          <label htmlFor={id} className="text-sm font-bold text-ink-soft">
            {label}
            {required && (
              <span className="text-danger-600" aria-hidden="true">
                {' '}*
              </span>
            )}
          </label>
          {action}
        </div>
        {children}
        {error ? (
          <p id={errorId} role="alert" className="mt-1.5 text-sm font-medium text-danger-600">
            {error}
          </p>
        ) : (
          hint && (
            <p id={hintId} className="mt-1.5 text-[13px] leading-relaxed text-muted">
              {hint}
            </p>
          )
        )}
      </div>
    </FieldCtx.Provider>
  );
};

function useFieldProps(error?: string) {
  const ctx = React.useContext(FieldCtx);
  const err = error ?? ctx?.error;
  return { id: ctx?.id, 'aria-describedby': ctx?.describedBy, 'aria-invalid': err ? true : undefined, err };
}

export const TextInput = React.forwardRef<
  HTMLInputElement,
  React.InputHTMLAttributes<HTMLInputElement> & { error?: string; suffix?: React.ReactNode }
>(({ className = '', error, suffix, ...rest }, ref) => {
  const { err, ...a11y } = useFieldProps(error);
  const input = <input ref={ref} {...a11y} {...rest} className={`${CONTROL} ${borderFor(err)} ${suffix ? 'pl-14' : ''} ${className}`} />;
  if (!suffix) return input;
  return (
    <div className="relative">
      {input}
      <span className="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-sm text-muted">{suffix}</span>
    </div>
  );
});
TextInput.displayName = 'TextInput';

export const Select = React.forwardRef<HTMLSelectElement, React.SelectHTMLAttributes<HTMLSelectElement> & { error?: string }>(
  ({ className = '', error, children, ...rest }, ref) => {
    const { err, ...a11y } = useFieldProps(error);
    return (
      <div className="relative">
        <select
          ref={ref}
          {...a11y}
          {...rest}
          className={`${CONTROL} ${borderFor(err)} appearance-none pl-10 truncate cursor-pointer ${className}`}
        >
          {children}
        </select>
        {/* Wrapper does the centering: the icon font's own CSS forces display:inline-block */}
        <span aria-hidden="true" className="pointer-events-none absolute inset-y-0 left-3 flex items-center text-muted">
          <span className="material-symbols-outlined !text-[20px]">expand_more</span>
        </span>
      </div>
    );
  }
);
Select.displayName = 'Select';

export const TextArea = React.forwardRef<HTMLTextAreaElement, React.TextareaHTMLAttributes<HTMLTextAreaElement> & { error?: string }>(
  ({ className = '', error, rows = 3, ...rest }, ref) => {
    const { err, ...a11y } = useFieldProps(error);
    return <textarea ref={ref} rows={rows} {...a11y} {...rest} className={`${CONTROL} ${borderFor(err)} py-3 leading-relaxed resize-y ${className}`} />;
  }
);
TextArea.displayName = 'TextArea';

// A group of choices shown as buttons that wrap onto new lines (never overflow the screen).
export interface ChoiceOption<T extends string | number> {
  value: T;
  label: React.ReactNode;
}

export function ChoiceGroup<T extends string | number>({
  label,
  options,
  value,
  onChange,
  multiple,
  columns,
  required,
  hint,
  error,
}: {
  label: React.ReactNode;
  options: ChoiceOption<T>[];
  value: T | T[] | undefined;
  onChange: (value: any) => void;
  multiple?: boolean;
  /** Fixed number of columns; otherwise buttons size to their text and wrap */
  columns?: 2 | 3 | 4 | 7;
  required?: boolean;
  hint?: React.ReactNode;
  error?: string;
}) {
  const id = useId();
  const selected = (v: T) => (Array.isArray(value) ? value.includes(v) : value === v);
  const toggle = (v: T) => {
    if (!multiple) return onChange(v);
    const list = Array.isArray(value) ? value : [];
    onChange(list.includes(v) ? list.filter((x) => x !== v) : [...list, v]);
  };
  const grid = columns
    ? { 2: 'grid grid-cols-2', 3: 'grid grid-cols-3', 4: 'grid grid-cols-4', 7: 'grid grid-cols-4 sm:grid-cols-7' }[columns]
    : 'flex flex-wrap';
  return (
    <div>
      <p id={`${id}-label`} className="mb-1.5 text-sm font-bold text-ink-soft">
        {label}
        {required && (
          <span className="text-danger-600" aria-hidden="true">
            {' '}*
          </span>
        )}
      </p>
      <div role={multiple ? 'group' : 'radiogroup'} aria-labelledby={`${id}-label`} className={`${grid} gap-2`}>
        {options.map((o) => {
          const on = selected(o.value);
          return (
            <button
              key={String(o.value)}
              type="button"
              role={multiple ? undefined : 'radio'}
              aria-checked={multiple ? undefined : on}
              aria-pressed={multiple ? on : undefined}
              onClick={() => toggle(o.value)}
              className={`min-h-11 rounded-[var(--radius-control)] border px-3.5 text-[15px] font-bold transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-brand-500 ${
                on ? 'border-brand-600 bg-brand-600 text-white' : 'border-line bg-surface text-ink-soft hover:border-brand-300 hover:bg-brand-50'
              }`}
            >
              {o.label}
            </button>
          );
        })}
      </div>
      {error ? (
        <p role="alert" className="mt-1.5 text-sm font-medium text-danger-600">
          {error}
        </p>
      ) : (
        hint && <p className="mt-1.5 text-[13px] leading-relaxed text-muted">{hint}</p>
      )}
    </div>
  );
}

// A titled group of fields inside a form.
export const FormSection: React.FC<{ title?: React.ReactNode; description?: React.ReactNode; children: React.ReactNode }> = ({
